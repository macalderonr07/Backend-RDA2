PORT=5050
# "*" permite cualquier origen (util para Thunder Client). En un cliente real,
# fijar el/los origenes exactos, separados por coma:
# http://localhost:5500,http://127.0.0.1:5500,https://macalderonr07.github.io
CLIENT_ORIGIN=*

# --- Base de datos: opcion A (recomendada en la nube) ---
# Si DATABASE_URL existe tiene prioridad sobre las variables PG* de abajo.
# Render la inyecta sola desde su base PostgreSQL (ver render.yaml).
# DATABASE_URL=postgres://usuario:clave@host:5432/productos_db

# --- Base de datos: opcion B (desarrollo local) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=productos_db
# "true" fuerza SSL (base gestionada fuera de la red interna del PaaS)
PGSSL=false
