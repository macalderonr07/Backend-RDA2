PORT=5070
# Origenes publicos permitidos (localhost/127.0.0.1 se permiten siempre)
CLIENT_ORIGIN=
# Usuario de base app_admin (rol ELITE_PRODUCCION), creado por db/11_administracion.sql
ORACLE_USER=app_admin
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_SCHEMA=PRODUCCION
JWT_DURACION=8h
# Secreto para firmar los JWT (minimo 32 caracteres aleatorios)
JWT_SECRETO=
# Primer administrador (npm run semilla)
ADMIN_CORREO=admin@comercialelite.ec
ADMIN_CLAVE=

# Solo detras de un proxy (despliegue): en que proxies confiar para X-Forwarded-For.
# Ej. uniquelocal (redes privadas de Docker). Vacio = ninguno.
TRUST_PROXY=
