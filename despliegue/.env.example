# Copiar a .env (NUNCA se sube al repositorio) y completar. Generar las claves con:
#   echo "C$(openssl rand -hex 12)"      (Oracle: letra al inicio, letras/números/_)
#   openssl rand -hex 32                 (JWT_SECRETO)

# Dominio público del servidor. En Azure, la etiqueta DNS de la IP pública:
#   <etiqueta>.<region>.cloudapp.azure.com
DOMINIO=

# Orígenes de los frontends (CORS), separados por coma. GitHub Pages:
CLIENT_ORIGIN=https://macalderonr07.github.io

# Clave de SYS/SYSTEM de Oracle (solo administración de la base)
ORACLE_SYS_PASSWORD=
# Dueños de los esquemas y usuarios de las APIs
CLAVE_PRODUCCION=
CLAVE_ECOMMERCE=
CLAVE_APP_WEB=
CLAVE_APP_ADMIN=

# API de administración
JWT_SECRETO=
ADMIN_CORREO=admin@comercialelite.ec
# 10 a 64 caracteres, con mayúscula, minúscula y número
ADMIN_CLAVE=

# Puertos publicados (por defecto 80 y 443; cambiarlos solo para pruebas locales)
PUERTO_HTTP=80
PUERTO_HTTPS=443
