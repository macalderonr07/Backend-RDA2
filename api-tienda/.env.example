PORT=5050
# Origenes permitidos separados por coma. Nunca "*" en produccion.
# localhost/127.0.0.1 (cualquier puerto) se permiten siempre; esta lista es
# para origenes de verdad (el dominio donde se publique la tienda).
CLIENT_ORIGIN=

# Oracle (contenedor bd2_oracle, imagen gvenzl/oracle-free -> PDB FREEPDB1).
# El usuario es app_web: solo tiene el rol ELITE_ECOMMERCE (ver db/01_usuario_app.sql).
ORACLE_USER=app_web
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
# Esquema sobre el que trabaja la sesion (nodo e-commerce)
ORACLE_SCHEMA=ECOMMERCE
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5

# Cache del catalogo en Redis (lectura principal; Oracle queda de respaldo).
# Sin definir: redis://localhost:6379. "off": todo se lee de Oracle.
# Contenedor de desarrollo: podman run -d --name ce_redis -p 6379:6379 docker.io/library/redis:7.4-alpine
REDIS_URL=
REDIS_PREFIJO=ce:
CACHE_INTERVALO_MS=200
CACHE_RECONCILIAR_MIN=30
CACHE_L1_MAXIMO=5000
CACHE_L1_TTL_MS=60000
CACHE_WORKER=on
